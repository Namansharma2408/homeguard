    <PackageJsonDependenciesTailwindcss Condition="$(PackageJsonDependenciesTailwindcss) == ''">^4.3.0</PackageJsonDependenciesTailwindcss>
    <PackageJsonDependenciesZod Condition="$(PackageJsonDependenciesZod) == ''">^4.4.3</PackageJsonDependenciesZod>
    <PackageJsonDevdependenciesEslintJs Condition="$(PackageJsonDevdependenciesEslintJs) == ''">^10.0.1</PackageJsonDevdependenciesEslintJs>
